{
  "name": "saturate-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "migrate:up": "node ./scripts/migrate.mjs up",
    "migrate:down": "node ./scripts/migrate.mjs down",
    "migrate:create": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./node_modules/.bin/node-pg-migrate create -m migrations",
    "test:accounts": "node ./scripts/test-api-accounts.mjs",
    "test:policies": "node ./scripts/test-api-policies.mjs",
    "test:ams:policies": "node ./scripts/test-ams-policies.mjs",
    "test:ams:contacts": "node ./scripts/test-ams-contacts.mjs",
    "test:ams:work-queue": "node ./scripts/test-ams-work-queue.mjs",
    "test:crm:pipelines": "node ./scripts/test-crm-pipelines.mjs",
    "test:crm:leads": "node ./scripts/test-crm-leads.mjs",
    "test:activities": "node ./scripts/test-activities-api.mjs",
    "test:tasks": "node ./scripts/test-tasks-api.mjs",
    "test:api": "npm run test:accounts && npm run test:policies && npm run test:ams:policies",
    "test:rls": "node ./scripts/test-rls.mjs",
    "test:renewals": "node ./scripts/test-phase1c-renewals.mjs",
    "test:api-smoke": "node ./scripts/test-phase1b-hardening.mjs",
    "test:phase1b:hardening": "node ./scripts/test-phase1b-hardening.mjs",
    "test:policy-transaction-accounting": "node ./scripts/test-policy-transaction-accounting.mjs",
    "jobs:renewals:run": "DOTENV_CONFIG_PATH=.env.local node -r dotenv/config ./scripts/jobs/run-renewals.mjs",
    "test:phase1c:renewals": "node ./scripts/test-phase1c-renewals.mjs",
    "test:renewal-cadence": "node ./scripts/test-renewal-cadence-normalization.mjs",
    "seed:dev": "node ./scripts/seed-dev-users.mjs",
    "seed:normalize-customers": "node ./scripts/normalize-dev-customer-names.mjs",
    "seed:normalize-policies": "node ./scripts/normalize-dev-policy-and-carrier-names.mjs",
    "test:auth": "node ./scripts/test-auth.mjs",
    "test:ui-shell": "node ./scripts/test-ui-shell.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "next": "16.1.6",
    "pg": "^8.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "node-pg-migrate": "^8.0.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
